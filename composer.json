{
    "name": "arkhan0072-dev/laravel-ledger",
    "description": "Double-entry accounting ledger for Laravel: balanced journal entries, integer money, account balances.",
    "type": "library",
    "keywords": ["laravel", "ledger", "accounting", "double-entry", "bookkeeping", "fintech", "trial-balance", "idempotency"],
    "homepage": "https://github.com/arkhan0072-dev/laravel-ledger",
    "license": "MIT",
    "authors": [
        { "name": "Abdulrehman Khan", "email": "abdulrehmankhan0072@gmail.com" }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": { "Arkhan\\Ledger\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Arkhan\\Ledger\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": { "providers": ["Arkhan\\Ledger\\LedgerServiceProvider"] }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
